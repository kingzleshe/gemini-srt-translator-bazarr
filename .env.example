# Optional initial values. These can also be configured in the web console.
GEMINI_API_KEY=replace-me
GEMINI_API_KEY1=

# Optional second Gemini key supported by gemini-srt-translator.
GEMINI_API_KEY2=

# Optional but recommended. Used only to build better translation context.
TMDB_API_KEY=

# Bazarr URL as seen from this worker container.
# Use http://bazarr:6767 if both containers share a Docker network, or a LAN URL.
BAZARR_URL=http://bazarr:6767

# Optional. If omitted, the worker tries to read it from mounted Bazarr config.yaml.
BAZARR_API_KEY=

# Install FFmpeg so gemini-srt-translator initialization succeeds even before
# upstream makes FFmpeg checks optional for SRT-only translation.
INSTALL_FFMPEG=true

# Published image used by docker compose pull.
GST_BAZARR_IMAGE=ghcr.io/kingzleshe/gemini-srt-translator-bazarr:latest

# Host paths used by docker-compose.yml.
MEDIA_ROOT=/mnt/data
BAZARR_CONFIG_DIR=/opt/docker/bazarr/config
BAZARR_POSTPROCESS_DIR=/opt/docker/bazarr/postprocess
WORKER_STATE_DIR=/opt/docker/gemini-srt-translator-bazarr

# gemini-srt-translator options.
GST_MODEL=gemini-flash-latest
GST_BATCH_SIZE=1000
GST_TARGET_LANGUAGE=Simplified Chinese

# Worker/runtime options.
WORKER_SLEEP_SECONDS=15
HTTP_TIMEOUT_SECONDS=20
